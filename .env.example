# 复制成 .env 再按需改。所有变量都有默认值，不配也能跑起来。

# 监听端口。容器里必须是 0.0.0.0:PORT，不要绑 127.0.0.1。
PORT=8000

# SQLite 文件位置。父目录不存在会自动创建。
# 只读文件系统上会降级成内存库，/api/health 的 persistent 会变成 false。
GOMOKU_DB=data/gomoku.db

# 日志级别：DEBUG / INFO / WARNING / ERROR。输出是单行 JSON，直接喂采集器。
GOMOKU_LOG=INFO

# 允许跨域的来源，逗号分隔。线上是同源部署，留空即可。
# 默认值只放了本地开发的 5173/8000 两个端口。
# GOMOKU_CORS=http://localhost:5173

# 可选的模型接入。任何 OpenAI 兼容接口都行；不配就走内置人格决策。
# GOMOKU_LLM_API_KEY=
# GOMOKU_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GOMOKU_LLM_MODEL=glm-4-flash

# C++ 通道的编译器。可以带参数，比如 "ccache g++"。
# CXX=g++
